#: code:addons/suite_ai_provider_pool/models/ai_agent.py:0
msgid ""
"Knowledge Sources require an OpenAI or Google API key for text embedding. "
"Your current chat model does not include an embedding service. Please "
"configure an OpenAI or Google key in Settings > AI."
msgstr ""

#. module: suite_ai_provider_pool
#: model:ir.model.fields,help:suite_ai_provider_pool.field_ai_agent__suite_web_search_enabled
msgid ""
"Let this agent search the web when answering. Odoo has no built-in toggle "
"for this — the Provider Pool wires it for every provider: OpenAI and Gemini "
"use their native web search, Claude uses its server-side search, and "
"DeepSeek / self-hosted models use Tavily (set a Tavily API key in Settings →"
" AI). OpenAI and Tavily results are localized to your company's country "
"automatically. Gemini cannot combine web search with tools, so it is skipped"
" silently when the agent has tools attached. Off by default."
msgstr ""

#. module: suite_ai_provider_pool
#: model:ir.model.fields,help:suite_ai_provider_pool.field_res_config_settings__suite_server_action_model
#: model_terms:ir.ui.view,arch_db:suite_ai_provider_pool.res_config_settings_view_form_suite_ai_provider_pool
msgid ""
"Model for Odoo's built-in AI automations (server actions / rules flagged "
"'AI', document sorting) — NOT the chatbot; AI Agents and the WhatsApp AI "
"keep their own model. Odoo defaults to OpenAI GPT-4.1; set this to use "
"Claude, DeepSeek or self-hosted. Leave empty to keep the default (needs an "
"OpenAI key)."
msgstr ""

